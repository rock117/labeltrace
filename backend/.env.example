# Compose postgres 映射到宿主机 5433（避免与本机 5432 冲突）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5433/labeltrace
BLOB_BACKEND=local
BLOB_LOCAL_ROOT=./data/blobs
BLOB_S3_BUCKET=labeltrace
BLOB_S3_ENDPOINT=
BLOB_S3_ACCESS_KEY=
BLOB_S3_SECRET_KEY=
BLOB_S3_REGION=us-east-1
# P0: pg（jobs 表队列）；独立 worker / 可选 redis 见 docs/jobs.md
JOB_BACKEND=pg
JOB_POLL_INTERVAL_SEC=0.5
JOB_LEASE_SEC=300
LOG_LEVEL=INFO
